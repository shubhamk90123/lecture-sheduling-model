<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Instructors</title>
    <link rel="stylesheet" href="/css/adminCss/manage-instructors.css">
  </head>

  <body>

    <div class="container">

      <h2>All Assigned Lectures </h2>

      <table>

        <thead>
          <tr>
            <th>ID</th>
            <th>Course Name</th>
            <th>Level</th>
            <th>Instructor</th>
            <th>Duration</th>
            <th>Start Date</th>
            <th>Action</th>
          </tr>
        </thead>

        <tbody>
          <tr>
            <% if (lectureData.length===0) { %>
          <tr>
            <td colspan="3">No instructors found</td>
          </tr>
          <% } %>
            <% lectureData.forEach((ins, idx)=> { %>
              <tr>
                <td>
                  <%= idx +1 %>
                </td>
                <td>
                  <%= ins.courseName %>
                </td>
                <td>
                  <%= ins.courseCode %>
                </td>
                <td>
                  <%= ins.instructor %>
                </td>
                <td>
                  <%= ins.duration %>
                </td>
                <td>
                  <%= ins.startDate %>
                </td>
                <td>
                  <button class="edit">Edit</button>
                  <button class="delete">Delete</button>
                </td>
              </tr>
              <% }) %>
                </tr>
        </tbody>

      </table>
      <div class="dashboard">
        <a href="/admin/dashboard">GO TO DASHBOARD</a>
      </div>
    </div>

  </body>

</html>