<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>

    <%- include('../partials/sidebar') %>

    <div class="main">
        <%- include('../partials/topbar') %>

        <div class="table-container p-1 border-radius-lg" style="margin: 1rem;">
            <div class="table-header">
                <div style="display: flex; align-items: center; gap: 15px;">
                    <div class="card-icon icon-amber" style="margin-bottom: 0;"><i class="fa-solid fa-clock-rotate-left"></i></div>
                    <h2 class="form-title">Previous Lectures</h2>
                </div>
            </div>

            <table>
                <thead>
                    <tr>
                        <th style="width: 50px;">No</th>
                        <th>Course Module</th>
                        <th>Instructor</th>
                        <th>Duration</th>
                        <th>Date Conducted</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!lectureData || lectureData.length === 0) { %>
                        <tr>
                            <td colspan="6" class="text-center" style="padding: 4rem; color: var(--text-muted);">
                                <i class="fa-solid fa-history" style="font-size: 2.5rem; opacity: 0.2; display: block; margin-bottom: 1rem;"></i>
                                No previous lectures found
                            </td>
                        </tr>
                    <% } %>
                    <% (lectureData || []).forEach((lec, idx) => { %>
                        <tr>
                            <td style="font-weight: 700; color: var(--text-muted);"><%= idx + 1 %></td>
                            <td>
                                <div style="font-weight: 700; color: var(--text-main);"><%= lec.courseName %></div>
                                <div class="badge badge-<%= (lec.courseCode || 'beginner').toLowerCase() %>" style="margin-top: 4px; display: inline-block;"><%= lec.courseCode %></div>
                            </td>
                            <td>
                                <div class="flex-center" style="justify-content: flex-start; gap: 10px;">
                                    <div class="user-avatar" style="width: 28px; height: 28px; font-size: 0.7rem; background: #e0e7ff; color: #4338ca;"><%= (lec.instructorName || 'U').charAt(0) %></div>
                                    <span style="font-weight: 600;"><%= lec.instructorName %></span>
                                </div>
                            </td>
                            <td>
                                <span style="font-weight: 600;"><%= lec.duration %></span>
                                <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600;">MINS</span>
                            </td>
                            <td style="font-weight: 600; color: var(--text-muted);">
                                <%= new Date(lec.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                            </td>
                            <td style="text-align: right;">
                                <div style="display: flex; gap: 8px; justify-content: flex-end;">
                                    <form action="/admin/delete-lecture/<%= lec.courseId %>/<%= lec.lectureId %>" method="POST" style="display: inline;">
                                        <button type="submit" class="btn-primary" style="padding: 6px 12px; background: #fff1f2; color: #e11d48; border: 1px solid #fecdd3; font-size: 0.75rem; box-shadow: none;" onclick="return confirm('Delete this record?')">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

</body>
</html>
