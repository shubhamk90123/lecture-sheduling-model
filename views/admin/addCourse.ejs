<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Course</title>
    <link rel="stylesheet" href="/css/addCourse.css">
  </head>

  <body>

    <div class="container">

      <h2>Add New Course</h2>

      <form action="/admin/add-course" method="POST">

        <div class="form-group">
          <label>Course Name</label>
          <input type="text" name="courseName" placeholder="Enter course name" required>
        </div>

        <div class="form-group">
          <label>Course Code</label>
          <input type="text" name="courseCode" placeholder="Enter course code" required>
        </div>

        <div class="form-group">
          <label>Instructor</label>
          <select name="instructor" required>
            <option value="">Select Instructor</option>
            <option value="john">John Smith</option>
            <option value="alex">Alex Johnson</option>
            <option value="emma">Emma Brown</option>
          </select>
        </div>

        <div class="form-group">
          <label>Course Duration</label>
          <input type="text" name="duration" placeholder="Example: 3 Months">
        </div>

        <div class="form-group">
          <label>Start Date</label>
          <input type="date" name="startDate">
        </div>

        <div class="form-group">
          <label>Description</label>
          <textarea name="description" rows="4" placeholder="Course description"></textarea>
        </div>

        <button type="submit">Add Course</button>

      </form>

    </div>

  </body>

</html>