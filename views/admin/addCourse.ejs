<!DOCTYPE html>
<html lang="en">

  <head>
    <%- include('../partials/head') %>
  </head>

  <body>

    <%- include('../partials/sidebar') %>

    <div class="main">

      <%- include('../partials/topbar') %>

      <div class="container">

        <form action="/admin/add-course" method="POST" enctype="multipart/form-data">

          <div class="form-group">
            <label>Course Name</label>
            <input type="text" name="name" placeholder="e.g. Web Development" required>
          </div>

          <div class="form-group">
            <label>Level</label>
            <select name="level" required>
              <option value="">Select Level</option>
              <option value="Beginner">Beginner</option>
              <option value="Intermediate">Intermediate</option>
              <option value="Advanced">Advanced</option>
            </select>
          </div>

          <div class="form-group">
            <label>Description</label>
            <textarea name="description" placeholder="Brief description of the course" rows="3"></textarea>
          </div>

          <div class="form-group">
            <label>Course Image</label>
            <input type="file" name="image" accept="image/*">
          </div>

          <button type="submit">Add Course</button>

        </form>

      </div>

    </div>

  </body>

</html>