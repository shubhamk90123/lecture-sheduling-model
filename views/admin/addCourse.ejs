<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Course</title>
    <link rel="stylesheet" href="/css/adminCss/addCourse.css">
  </head>

  <body>

    <div class="container">

      <h2>Add New Course</h2>

      <form action="/admin/add-course" method="POST">

        <div class="form-group">
          <label>Select The Course</label>
          <select name="specialization" id="specializationSelect" required>
            <option value="">Select The Subject</option>
            <option value="Web Development">Web Development</option>
            <option value="Data Science">Data Science</option>
            <option value="Cyber Security">Cyber Security</option>
            <option value="DBMS">DBMS</option>
            <option value="Green Computing">Green Computing</option>
          </select>
        </div>

        <div class="form-group">
          <label>Course Code</label>
          <input type="text" name="courseCode" placeholder="Enter course code" required>
        </div>

        <div class="form-group">
          <label>Instructor</label>
          <select name="instructor" required>
            <option value="">Select Instructor</option>
            <option value="john">John Smith</option>
            <option value="alex">Alex Johnson</option>
            <option value="emma">Emma Brown</option>
          </select>
        </div>

        <div class="form-group">
          <label>Course Duration</label>
          <input type="text" name="duration" placeholder="Example: 3 Months" required>
        </div>

        <div class="form-group">
          <label>Start Date</label>
          <input type="date" name="startDate" required>
        </div>



        <button type="submit">Add Course</button>

      </form>

    </div>

  </body>

</html>