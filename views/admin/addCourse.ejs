<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>

    <%- include('../partials/sidebar') %>

    <div class="main">
        <%- include('../partials/topbar') %>

        <div class="form-card-container">
            <div class="table-container p-3">
                <!-- Page Header -->
                <div class="text-center mb-2">
                    <div class="form-header-icon course flex-center">
                        <i class="fa-solid fa-folder-plus"></i>
                    </div>
                    <h2 class="form-title">Create New Course</h2>
                    <p class="form-subtitle">Initialize a new subject module in the repository</p>
                </div>

                <!-- Form -->
                <form action="/admin/add-course" method="POST" enctype="multipart/form-data">
                    <div class="grid-2 mb-1">
                        <div class="form-group">
                            <label><i class="fa-solid fa-signature text-primary-small"></i> Course Name</label>
                            <input type="text" name="name" placeholder="e.g. DBMS" required>
                        </div>

                        <div class="form-group">
                            <label><i class="fa-solid fa-layer-group text-primary-small"></i> Complexity</label>
                            <select name="level" required>
                                <option value="">Select Level</option>
                                <option value="Beginner">Beginner</option>
                                <option value="Intermediate">Intermediate</option>
                                <option value="Advanced">Advanced</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label><i class="fa-solid fa-align-left text-primary-small"></i> Description</label>
                        <textarea name="description" placeholder="Briefly describe the course objectives..." rows="4" style="resize: none;"></textarea>
                    </div>

                    <div class="form-group">
                        <label><i class="fa-solid fa-image text-primary-small"></i> Banner Image</label>
                        <label class="file-upload-box" for="file-upload">
                            <i class="fa-solid fa-cloud-arrow-up upload-icon"></i>
                            <span class="upload-label">Choose Course Banner</span>
                            <input id="file-upload" name="image" type="file" style="display: none;" accept="image/*" 
                                onchange="if(this.files[0]) document.getElementById('file-name').textContent = 'Selected: ' + this.files[0].name">
                            <p id="file-name" class="mt-1">PNG, JPG, WEBP up to 10MB</p>
                        </label>
                    </div>

                    <div class="mt-2">
                        <button type="submit" class="btn-primary w-full py-1 text-lg shadow-primary">
                            <i class="fa-solid fa-circle-check mr-1"></i> Launch Course
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</body>
</html>