<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>

    <%- include('../partials/sidebar') %>

    <div class="main">
        <%- include('../partials/topbar') %>

        <div class="form-card-container">
            <div class="table-container p-3">
                <div class="text-center mb-2">
                    <div class="form-header-icon schedule flex-center">
                        <i class="fa-solid fa-calendar-plus"></i>
                    </div>
                    <h2 class="form-title">Schedule New Session</h2>
                    <p class="form-subtitle">Map a faculty member to a specific course module</p>
                </div>

                <% if (typeof errorMessage !== "undefined" && errorMessage) { %>
                    <div class="error-msg mb-2">
                        <i class="fa-solid fa-triangle-exclamation"></i> <%= errorMessage %>
                    </div>
                <% } %>

                <form action="/admin/sheduleLec" method="POST">
                    <div class="grid-2 mb-1">
                        <div class="form-group">
                            <label><i class="fa-solid fa-book text-primary-small"></i> Course Name</label>
                            <select name="courseName" required>
                                <option value="">Select Course</option>
                                <% (courseData || []).forEach(course => { %>
                                    <option value="<%= course.name %>"><%= course.name %></option>
                                <% }); %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label><i class="fa-solid fa-chalkboard-user text-primary-small"></i> Instructor</label>
                            <select name="instructor" required>
                                <option value="">Select Instructor</option>
                                <% (instructors || []).forEach(ins => { %>
                                    <option value="<%= ins.name %>"><%= ins.name %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>

                    <div class="grid-2 mb-2">
                        <div class="form-group">
                            <label><i class="fa-solid fa-clock text-primary-small"></i> Duration (mins)</label>
                            <input type="number" name="duration" placeholder="e.g. 60" required>
                        </div>

                        <div class="form-group">
                            <label><i class="fa-solid fa-calendar-day text-primary-small"></i> Start Date</label>
                            <input type="date" name="startDate" required>
                        </div>
                    </div>

                    <button type="submit" class="btn-primary w-full py-1 text-lg shadow-primary">
                        <i class="fa-solid fa-check-circle mr-1"></i> Finalize Schedule
                    </button>
                </form>
            </div>
            <p class="text-center text-muted-caps mt-2">
                <i class="fa-solid fa-shield-halved"></i> Conflict detection active
            </p>
        </div>
    </div>

</body>
</html>