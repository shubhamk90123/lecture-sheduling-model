<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Courses</title>
    <link rel="stylesheet" href="/css/allCourses.css">
  </head>

  <body>
    <div class="container">
      <h2>All Courses</h2>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Course Name</th>
            <th>Course Code</th>
            <th>Instructor</th>
            <th>Duration</th>
            <th>Start Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <tr>

            <% courseData.forEach((course, idx)=> { %>
              <td>
                <%= idx + 1 %>
              </td>
              <td>
                <%= course.courseName %>
              </td>
              <td>
                <%= course.courseCode %>
              </td>
              <td>
                <%= course.instructor %>
              </td>
              <td>
                <%= course.duration %>
              </td>
              <td>
                <%= course.startDate %>
              </td>
              <td>
                <button class="edit">edit</button>
                <button class="delete"> Delete</button>
              </td>
              <% }); %>
          </tr>
        </tbody>
      </table>
    </div>
  </body>

</html>