<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/css/adminCss/adminDashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  </head>

  <body>

    <div class="sidebar">

      <h2>Lecture Scheduler</h2>

      <ul>
        <li><i class="fa fa-home"></i><a href="/admin/dashboard"> Dashboard</a></li>
        <li><i class="fa fa-book"></i> <a href="/admin/viewCourses">Courses</a></li>
        <li><i class="fa fa-users"></i> <a href="/admin/viewInstructors">Instructors</a></li>
        <li><i class="fa fa-calendar"></i> <a href="/admin/manageLecture">Manage Lectures</a></li>
        <li><i class="fa fa-sign-out"></i> <a href="/">Logout</a></li>
      </ul>

    </div>

    <div class="main">

      <div class="topbar">
        <h1>Admin Dashboard</h1>
        <div class="profile">
          Welcome, Admin
          <i class="fa fa-user-circle"></i>
        </div>
      </div>

      <div class="cards">

        <div class="card">
          <h3>Total Courses</h3>
          <p>
            <%= totalCourses %>
          </p>
        </div>

        <div class="card">
          <h3>Total Instructors</h3>
          <p>
            <%= totalInstructors %>
          </p>
        </div>

        <div class="card">
          <h3>Scheduled Lectures</h3>
          <p>
            <%= totalSheduleLec %>
          </p>
        </div>

      </div>

      <div class="tables">
        <div class="table-box">
          <div class="table-header">
            <h3>Courses List</h3>
            <a href="/admin/add-course">Add Course</a>
          </div>

          <table>
            <tr>
              <th>No</th>
              <th>Course Name</th>
              <th>Level</th>
              <th>Duration</th>
            </tr>
            <% const limitedCourses=(courseData || []).slice(0, 3); %>
              <% if (limitedCourses.length===0) { %>
                <tr>
                  <td colspan="3">No courses found</td>
                </tr>
                <% } %>
                  <% limitedCourses.forEach((course, idx)=> { %>
                    <tr>
                      <td>
                        <%= idx + 1 %>
                      </td>
                      <td>
                        <%= course.courseName %>
                      </td>
                      <td>
                        <%= course.courseCode %>
                      </td>
                      <td>
                        <%= course.duration %>
                      </td>
                    </tr>
                    <% }); %>
          </table>

        </div>

        <div class="table-box">

          <div class="table-header">
            <h3>Instructors List</h3>
            <a href="/admin/viewInstructors">View All Instructors</a>
          </div>
          <table>

            <tbody>
              <tr>
                <th>No</th>
                <th>Name</th>
                <th>Email</th>
              </tr>
              <% const limitedInstructors=(instructors || []).slice(0, 3); %>
                <% if (limitedInstructors.length===0) { %>
                  <tr>
                    <td colspan="3">No instructors found</td>
                  </tr>
                  <% } %>
                    <% limitedInstructors.forEach((ins, idx)=> { %>
                      <tr>
                        <td>
                          <%= idx +1 %>
                        </td>
                        <td>
                          <%= ins.name %>
                        </td>
                        <td>
                          <%= ins.email %>
                        </td>

                      </tr>
                      <% }) %>

            </tbody>

          </table>

        </div>

      </div>

      <div class="table-box full">

        <div class="table-header">
          <h3>Scheduled Lectures</h3>
          <a href="/admin/sheduleLec">Schedule Lecture</a>
        </div>

        <table>

          <tr>
            <th>Course</th>
            <th>Instructor</th>
            <th>Duration</th>
            <th>Date</th>
            <th>Actions</th>
          </tr>

          <% if (!lectureData || lectureData.length===0) { %>
            <tr>
              <td colspan="4">No lectures scheduled</td>
            </tr>
            <% } %>

              <% lectureData.forEach((lec)=> { %>
                <tr>
                  <td>
                    <%= lec.courseName %>
                  </td>
                  <td>
                    <%= lec.instructor %>
                  </td>
                  <td>
                    <%= lec.duration %>
                  </td>
                  <td>
                    <%= lec.startDate %>
                  </td>
                  <td>
                    <button class="edit">Edit</button>
                    <button class="delete">Delete</button>
                  </td>
                </tr>
                <% }) %>

        </table>

      </div>

    </div>

  </body>

</html>