<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/css/adminCss/adminDashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  </head>

  <body>

    <div class="sidebar">

      <h2>Lecture Scheduler</h2>

      <ul>
        <li><i class="fa fa-home"></i><a href="/admin/dashboard"> Dashboard</a></li>
        <li><i class="fa fa-book"></i> <a href="/admin/viewCourses">Courses</a></li>
        <li><i class="fa fa-users"></i> <a href="/admin/viewInstructors">Instructors</a></li>
        <li><i class="fa fa-calendar"></i> <a href="/admin/manageLecture">Manage Lectures</a></li>
        <li><i class="fa fa-sign-out"></i> <a href="/">Logout</a></li>
      </ul>

    </div>
+
    <div class="main">

      <div class="topbar">
        <h1>Admin Dashboard</h1>
        <div class="profile">
          <a href="">Welcome, Admin</a>
          <i class="fa fa-user-circle"></i>
        </div>
      </div>

      <div class="cards">

        <div class="card">
          <h3>Total Courses</h3>
          <p>8</p>
        </div>

        <div class="card">
          <h3>Total Instructors</h3>
          <p>5</p>
        </div>

        <div class="card">
          <h3>Scheduled Lectures</h3>
          <p>12</p>
        </div>

      </div>

      <div class="tables">

        <div class="table-box">
          <div class="table-header">
            <h3>Courses List</h3>
            <a href="/admin/add-course">Add Course</a>
          </div>

          <table>
            <tr>
              <th>Course Name</th>
              <th>Level</th>
            </tr>

            <tr>
              <td>Web Development</td>
              <td>Beginner</td>
            </tr>

            <tr>
              <td>Data Science</td>
              <td>Intermediate</td>
            </tr>

            <tr>
              <td>Cyber Security</td>
              <td>Advanced</td>
            </tr>

          </table>

        </div>

        <div class="table-box">

          <div class="table-header">
            <h3>Instructors List</h3>
            <a href="/admin/viewInstructors">View All Instructors</a>
          </div>
          <table>

            <tbody>
              <tr>
                <th>Name</th>
                <th>Email</th>
              </tr>
              <% if (!instructors || instructors.length===0) { %>
                <tr>
                  <td colspan="6">No instructors found</td>
                </tr>
                <% } %>
                  <% instructors.forEach((ins, idx)=> { %>
                    <tr>

                      <td>
                        <%= ins.name %>
                      </td>
                      <td>
                        <%= ins.email %>
                      </td>

                    </tr>
                    <% }) %>

            </tbody>

          </table>

        </div>

      </div>

      <div class="table-box full">

        <div class="table-header">
          <h3>Scheduled Lectures</h3>
          <a href="/admin/manageLecture">Schedule Lecture</a>
        </div>

        <table>

          <tr>
            <th>Course</th>
            <th>Instructor</th>
            <th>Date</th>
            <th>Actions</th>
          </tr>

          <tr>
            <td>Data Science</td>
            <td>John Doe</td>
            <td>June 15, 2024</td>
            <td>
              <button class="edit">Edit</button>
              <button class="delete">Delete</button>
            </td>
          </tr>

          <tr>
            <td>Web Development</td>
            <td>Jane Smith</td>
            <td>June 18, 2024</td>
            <td>
              <button class="edit">Edit</button>
              <button class="delete">Delete</button>
            </td>
          </tr>

          <tr>
            <td>Cyber Security</td>
            <td>Mike Johnson</td>
            <td>June 22, 2024</td>
            <td>
              <button class="edit">Edit</button>
              <button class="delete">Delete</button>
            </td>
          </tr>

        </table>

      </div>

    </div>

  </body>

</html>