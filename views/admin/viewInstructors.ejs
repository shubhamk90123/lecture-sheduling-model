<!DOCTYPE html>
<html lang="en">

  <head>
    <%- include('../partials/head') %>
  </head>

  <body>

    <%- include('../partials/sidebar') %>

      <div class="main">

        <%- include('../partials/topbar') %>

          <div class="container">

            <div class="header">
              <h2>Manage Instructors</h2>
            </div>

            <table>
              <thead>
                <tr>
                  <th>No</th>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Specialization</th>
                  <th>Phone</th>

                </tr>
              </thead>
              <tbody>
                <% if (!instructors || instructors.length===0) { %>
                  <tr>
                    <td colspan="6">No instructors found</td>
                  </tr>
                  <% } %>
                    <% (instructors || []).forEach((ins, idx)=> { %>
                      <tr>
                        <td>
                          <%= idx + 1 %>
                        </td>
                        <td>
                          <%= ins.name %>
                        </td>
                        <td>
                          <%= ins.email %>
                        </td>
                        <td>
                          <%= ins.specialization || '—' %>
                        </td>
                        <td>
                          <%= ins.contact %>
                        </td>

                      </tr>
                      <% }); %>
              </tbody>
            </table>

          </div>

      </div>

  </body>

</html>