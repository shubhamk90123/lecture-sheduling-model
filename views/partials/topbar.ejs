<div class="topbar">
  <div>
    <h1 style="margin: 0;"><%= pageTitle %></h1>
    <p style="color: var(--text-muted); font-size: 0.875rem; margin-top: 4px;">Manage your academic schedule with ease</p>
  </div>

  <div class="user-profile">
    <div class="user-avatar">
      <%= currentUserName ? currentUserName.charAt(0).toUpperCase() : 'U' %>
    </div>
    <div class="user-info">
      <span style="font-size: 0.7rem; color: var(--text-muted); display: block; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Welcome back</span>
      <span style="font-weight: 700; color: var(--text-main);"><%= currentUserName %></span>
    </div>
  </div>
</div>
