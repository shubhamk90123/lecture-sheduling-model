<div class="topbar">
  <div class="d-flex align-center">
    <button class="menu-toggle" id="menuToggle">
        <i class="fa-solid fa-bars"></i>
    </button>
    <div>
      <h1 class="m-0"><%= pageTitle %></h1>
      <p class="text-muted text-sm mt-05">Manage your academic schedule with ease</p>
    </div>
  </div>

  <div class="user-profile">
    <div class="user-avatar">
      <%= currentUserName ? currentUserName.charAt(0).toUpperCase() : 'U' %>
    </div>
    <div class="user-info">
      <span class="text-xs d-block font-700 text-muted-caps">Welcome back</span>
      <span class="font-700 text-main"><%= currentUserName %></span>
    </div>
  </div>
</div>
