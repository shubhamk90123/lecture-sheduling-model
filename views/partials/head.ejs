<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pageTitle %></title>

<!-- Font & Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<!-- Tailwind CSS -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          primary: {
            DEFAULT: '#6366f1',
            dark: '#4f46e5',
            light: '#818cf8',
          },
          secondary: '#ec4899',
          accent: '#f59e0b',
        },
        fontFamily: {
          sans: ['Plus Jakarta Sans', 'sans-serif'],
        },
        animation: {
          'fade-in': 'fadeIn 0.5s ease forwards',
        },
        keyframes: {
          fadeIn: {
            'from': { opacity: '0', transform: 'translateY(10px)' },
            'to': { opacity: '1', transform: 'translateY(0)' },
          }
        }
      }
    }
  }
</script>

<style type="text/tailwindcss">
  @layer components {
    .main-content {
      @apply flex-1 ml-[280px] p-8 min-h-screen transition-all duration-300;
    }
    .table-container {
      @apply bg-white rounded-[24px] p-6 border border-slate-200 shadow-sm transition-all duration-300;
    }
    .badge {
      @apply px-3 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider;
    }
    .badge-beginner { @apply bg-emerald-100 text-emerald-700; }
    .badge-intermediate { @apply bg-amber-100 text-amber-700; }
    .badge-advanced { @apply bg-rose-100 text-rose-700; }
    
    .form-group { @apply mb-6; }
    .form-group label { @apply block text-[10px] font-extrabold text-slate-500 uppercase tracking-widest mb-2 ml-1; }
    .form-group input, .form-group select, .form-group textarea {
      @apply w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-sm transition-all focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/10 focus:bg-white focus:-translate-y-0.5;
    }
    .btn-primary {
      @apply bg-gradient-to-br from-primary to-primary-dark text-white px-6 py-3 rounded-xl font-bold transition-all hover:scale-[1.02] hover:shadow-lg hover:shadow-primary/30 active:scale-95 flex items-center gap-2;
    }
    .card-stat {
      @apply bg-white p-6 rounded-[24px] border border-slate-100 shadow-sm transition-all hover:-translate-y-2 hover:shadow-xl;
    }
  }
  
  body {
    @apply bg-slate-50 text-slate-900 font-sans;
    background-image: 
      radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.03) 0px, transparent 50%),
      radial-gradient(at 100% 0%, rgba(236, 72, 153, 0.03) 0px, transparent 50%);
  }
</style>
