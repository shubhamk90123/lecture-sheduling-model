<div class="mobile-overlay" id="mobileOverlay"></div>
<div class="sidebar" id="sidebar">
  <div class="sidebar-close" id="sidebarClose">
    <i class="fa-solid fa-xmark"></i>
  </div>
  <div class="sidebar-logo">
    <i class="fa-solid fa-graduation-cap"></i>
    <span>LMS Portal</span>
  </div>
  <ul>
    <li>
      <a href="/<%= role === 'admin' ? 'admin/dashboard' : 'instructor/instructorDashboard' %>" class="<%= pageTitle === 'Dashboard' ? 'active' : '' %>">
        <i class="fa-solid fa-house"></i> <span>Dashboard</span>
      </a>
    </li>
    <% if (role === 'admin') { %>
      <li><a href="/admin/add-course" class="<%= pageTitle === 'Add Course' ? 'active' : '' %>"><i class="fa-solid fa-plus"></i> <span>Add Course</span></a></li>
      <li><a href="/admin/viewCourses" class="<%= pageTitle === 'All Courses' ? 'active' : '' %>"><i class="fa-solid fa-book-open"></i> <span>All Courses</span></a></li>
      <li><a href="/admin/viewInstructors" class="<%= pageTitle === 'Instructors' ? 'active' : '' %>"><i class="fa-solid fa-chalkboard-user"></i> <span>Instructors</span></a></li>
      <li><a href="/admin/manageLecture" class="<%= pageTitle === 'Manage Lectures' ? 'active' : '' %>"><i class="fa-solid fa-list-check"></i> <span>Manage Lectures</span></a></li>
      <li><a href="/admin/previousLecture" class="<%= pageTitle === 'Previous Lectures' ? 'active' : '' %>"><i class="fa-solid fa-clock-rotate-left"></i> <span>Previous Lectures</span></a></li>
      <li><a href="/admin/sheduleLec" class="<%= pageTitle === 'Schedule Lecture' ? 'active' : '' %>"><i class="fa-solid fa-calendar-plus"></i> <span>Schedule Lec</span></a></li>
    <% } else { %>
      <li><a href="/instructor/lectures" class="<%= pageTitle === 'My Lectures' ? 'active' : '' %>"><i class="fa-solid fa-book-reader"></i> <span>My Lectures</span></a></li>
    <% } %>
    <li><a href="/<%= role %>/profile" class="<%= pageTitle === 'My Profile' ? 'active' : '' %>"><i class="fa-solid fa-user-gear"></i> <span>Profile</span></a></li>
    <li><a href="/logout" style="margin-top: 2rem; color: #f87171;"><i class="fa-solid fa-right-from-bracket"></i> <span>Logout</span></a></li>
  </ul>
</div>
