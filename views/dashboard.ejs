<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body>

    <%- include('partials/sidebar') %>

    <div class="main">
        <%- include('partials/topbar') %>

        <!-- STATS CARDS -->
        <div class="cards">
            <% if (role === 'admin') { %>
                <div class="card">
                    <div class="card-icon icon-blue"><i class="fa-solid fa-book"></i></div>
                    <h3>Total Courses</h3>
                    <p><%= totalCourses %></p>
                </div>
                <div class="card">
                    <div class="card-icon icon-pink"><i class="fa-solid fa-users"></i></div>
                    <h3>Total Instructors</h3>
                    <p><%= totalInstructors %></p>
                </div>
                <div class="card">
                    <div class="card-icon icon-amber"><i class="fa-solid fa-calendar-check"></i></div>
                    <h3>Scheduled</h3>
                    <p><%= totalSheduleLec %></p>
                </div>
            <% } else { %>
                <div class="card">
                    <div class="card-icon icon-blue"><i class="fa-solid fa-graduation-cap"></i></div>
                    <h3>My Lectures</h3>
                    <p><%= totalSheduleLec %></p>
                </div>
                <div class="card">
                    <div class="card-icon icon-pink"><i class="fa-solid fa-clock"></i></div>
                    <h3>Upcoming</h3>
                    <p><%= upcomingLectures %></p>
                </div>
                <div class="card">
                    <div class="card-icon icon-amber"><i class="fa-solid fa-circle-check"></i></div>
                    <h3>Completed</h3>
                    <p><%= pastLectures %></p>
                </div>
            <% } %>
        </div>

        <!-- MAIN TABLES -->
        <% if (role === 'admin') { %>
            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; margin-bottom: 2rem;">
                <!-- Courses Table -->
                <div class="table-container">
                    <div class="table-header">
                        <h2>Top Courses</h2>
                        <a href="/admin/viewCourses" class="btn-primary" style="padding: 8px 16px; font-size: 0.8rem;">View All</a>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>Course</th>
                                <th>Level</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% (courseData || []).slice(0, 4).forEach(course => { %>
                                <tr>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 12px;">
                                            <img src="<%= course.image || '/images/default-course.png' %>" style="width: 35px; height: 35px; border-radius: 8px; object-fit: cover;">
                                            <span style="font-weight: 600;"><%= course.name %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge badge-<%= (course.level || '').toLowerCase() %>"><%= course.level %></span>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Instructors Mini Table -->
                <div class="table-container">
                    <div class="table-header">
                        <h2>Team</h2>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        <% (instructors || []).slice(0, 4).forEach(ins => { %>
                            <div style="display: flex; align-items: center; gap: 12px; padding: 8px; background: #f8fafc; border-radius: 12px; border: 1px solid #f1f5f9;">
                                <div class="user-avatar" style="width: 32px; height: 32px; font-size: 0.75rem; background: var(--primary);"><%= ins.name.charAt(0) %></div>
                                <div style="overflow: hidden;">
                                    <div style="font-weight: 600; font-size: 0.875rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= ins.name %></div>
                                    <div style="font-size: 0.7rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= ins.email %></div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>

            <!-- Full Width Lecture Table -->
            <div class="table-container">
                <div class="table-header">
                    <h2>Recent Schedules</h2>
                    <a href="/admin/sheduleLec" class="btn-primary" style="padding: 8px 16px; font-size: 0.8rem;"><i class="fa fa-plus"></i> New</a>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Instructor</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!lectureData || lectureData.length === 0) { %>
                            <tr><td colspan="4" style="text-align: center; padding: 3rem; color: var(--text-muted);">No lectures scheduled yet</td></tr>
                        <% } %>
                        <% (lectureData || []).slice(0, 5).forEach(lec => { %>
                            <tr>
                                <td style="font-weight: 600;"><%= lec.courseName %></td>
                                <td><%= lec.instructorName %></td>
                                <td style="color: var(--text-muted); font-weight: 500;"><%= new Date(lec.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
                                <td><span class="badge" style="background: #e0e7ff; color: #4338ca;">Confirmed</span></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

        <% } else { %>
            <!-- Instructor Specific View -->
            <div class="table-container">
                <div class="table-header">
                    <h2>My Upcoming Sessions</h2>
                    <a href="/instructor/lectures" class="btn-primary" style="padding: 8px 16px; font-size: 0.8rem;">Full Schedule</a>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Date</th>
                            <th>Duration</th>
                            <th>Level</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!lectureData || lectureData.length === 0) { %>
                            <tr><td colspan="4" style="text-align: center; padding: 3rem; color: var(--text-muted);">No lectures assigned yet</td></tr>
                        <% } %>
                        <% (lectureData || []).slice(0, 6).forEach(lec => { %>
                            <tr>
                                <td style="font-weight: 600;"><%= lec.courseName %></td>
                                <td style="color: var(--text-muted); font-weight: 500;"><%= new Date(lec.date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %></td>
                                <td><%= lec.duration %> mins</td>
                                <td><span class="badge badge-<%= (lec.courseCode || 'beginner').toLowerCase() %>"><%= lec.courseCode %></span></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

</body>
</html>
