<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body class="flex min-h-screen">

    <%- include('partials/sidebar') %>

    <main class="main-content">
        <%- include('partials/topbar') %>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
            <% if (role === 'admin') { %>
                <div class="card-stat">
                    <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center text-xl mb-4">
                        <i class="fa-solid fa-book"></i>
                    </div>
                    <h3 class="text-slate-500 text-sm font-bold uppercase tracking-wider mb-1">Total Courses</h3>
                    <p class="text-3xl font-extrabold text-slate-900"><%= totalCourses %></p>
                </div>

                <div class="card-stat">
                    <div class="w-12 h-12 bg-pink-50 text-pink-600 rounded-2xl flex items-center justify-center text-xl mb-4">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <h3 class="text-slate-500 text-sm font-bold uppercase tracking-wider mb-1">Total Instructors</h3>
                    <p class="text-3xl font-extrabold text-slate-900"><%= totalInstructors %></p>
                </div>

                <div class="card-stat">
                    <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center text-xl mb-4">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                    <h3 class="text-slate-500 text-sm font-bold uppercase tracking-wider mb-1">Scheduled</h3>
                    <p class="text-3xl font-extrabold text-slate-900"><%= totalSheduleLec %></p>
                </div>
            <% } else { %>
                <div class="card-stat">
                    <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center text-xl mb-4">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <h3 class="text-slate-500 text-sm font-bold uppercase tracking-wider mb-1">My Lectures</h3>
                    <p class="text-3xl font-extrabold text-slate-900"><%= totalSheduleLec %></p>
                </div>

                <div class="card-stat">
                    <div class="w-12 h-12 bg-pink-50 text-pink-600 rounded-2xl flex items-center justify-center text-xl mb-4">
                        <i class="fa-solid fa-clock"></i>
                    </div>
                    <h3 class="text-slate-500 text-sm font-bold uppercase tracking-wider mb-1">Upcoming</h3>
                    <p class="text-3xl font-extrabold text-slate-900"><%= upcomingLectures %></p>
                </div>

                <div class="card-stat">
                    <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center text-xl mb-4">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <h3 class="text-slate-500 text-sm font-bold uppercase tracking-wider mb-1">Completed</h3>
                    <p class="text-3xl font-extrabold text-slate-900"><%= pastLectures %></p>
                </div>
            <% } %>
        </div>

        <!-- Tables Section -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
            <% if (role === 'admin') { %>
                <!-- Top Courses -->
                <div class="lg:col-span-2 table-container">
                    <div class="flex justify-between items-center mb-8">
                        <h2 class="text-xl font-extrabold text-slate-900">Top Courses</h2>
                        <a href="/admin/viewCourses" class="text-primary font-bold text-sm hover:underline">View All</a>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-separate border-spacing-y-2">
                            <thead>
                                <tr class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest">
                                    <th class="px-4 py-2">Course</th>
                                    <th class="px-4 py-2">Level</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% (courseData || []).slice(0, 4).forEach(course => { %>
                                    <tr class="group">
                                        <td class="px-4 py-4 bg-slate-50 group-hover:bg-indigo-50/50 rounded-l-2xl transition-all">
                                            <div class="flex items-center gap-4">
                                                <img src="<%= course.image || '/images/default-course.png' %>" class="w-10 h-10 rounded-xl object-cover shadow-sm">
                                                <span class="font-bold text-slate-800"><%= course.name %></span>
                                            </div>
                                        </td>
                                        <td class="px-4 py-4 bg-slate-50 group-hover:bg-indigo-50/50 rounded-r-2xl transition-all">
                                            <span class="badge badge-<%= (course.level || '').toLowerCase() %>"><%= course.level %></span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Instructors Sidebar -->
                <div class="table-container">
                    <div class="flex justify-between items-center mb-8">
                        <h2 class="text-xl font-extrabold text-slate-900">The Team</h2>
                    </div>
                    <div class="space-y-4">
                        <% (instructors || []).slice(0, 5).forEach(ins => { %>
                            <div class="flex items-center gap-4 p-3 bg-slate-50 rounded-2xl hover:shadow-md transition-all cursor-pointer border border-transparent hover:border-slate-100">
                                <div class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center font-bold text-sm shadow-inner">
                                    <%= ins.name.charAt(0) %>
                                </div>
                                <div class="overflow-hidden">
                                    <p class="font-bold text-slate-800 text-sm truncate"><%= ins.name %></p>
                                    <p class="text-[10px] font-bold text-slate-400 truncate"><%= ins.email %></p>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            <% } %>
        </div>

        <!-- Recent Schedules (Full Width) -->
        <div class="table-container mb-12">
            <div class="flex justify-between items-center mb-8">
                <h2 class="text-xl font-extrabold text-slate-900">
                    <%= role === 'admin' ? 'Recent Schedules' : 'My Upcoming Sessions' %>
                </h2>
                <a href="<%= role === 'admin' ? '/admin/sheduleLec' : '/instructor/lectures' %>" class="btn-primary py-2 px-5 text-sm">
                    <i class="fa-solid fa-<%= role === 'admin' ? 'calendar-plus' : 'list' %>"></i>
                    <%= role === 'admin' ? 'New Schedule' : 'Full Schedule' %>
                </a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-separate border-spacing-y-2">
                    <thead>
                        <tr class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest">
                            <th class="px-6 py-2">Course</th>
                            <th class="px-6 py-2"><%= role === 'admin' ? 'Instructor' : 'Level' %></th>
                            <th class="px-6 py-2">Date</th>
                            <th class="px-6 py-2">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!lectureData || lectureData.length === 0) { %>
                            <tr><td colspan="4" class="text-center py-10 text-slate-400 font-bold">No sessions found</td></tr>
                        <% } %>
                        <% (lectureData || []).slice(0, 6).forEach(lec => { %>
                            <tr class="group">
                                <td class="px-6 py-5 bg-slate-50 group-hover:bg-indigo-50/50 rounded-l-2xl transition-all font-bold text-slate-800">
                                    <%= lec.courseName %>
                                </td>
                                <td class="px-6 py-5 bg-slate-50 group-hover:bg-indigo-50/50 transition-all font-medium text-slate-600">
                                    <% if (role === 'admin') { %>
                                        <%= lec.instructorName %>
                                    <% } else { %>
                                        <span class="badge badge-<%= (lec.courseCode || 'beginner').toLowerCase() %>"><%= lec.courseCode %></span>
                                    <% } %>
                                </td>
                                <td class="px-6 py-5 bg-slate-50 group-hover:bg-indigo-50/50 transition-all text-slate-500 font-semibold">
                                    <%= new Date(lec.date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %>
                                </td>
                                <td class="px-6 py-5 bg-slate-50 group-hover:bg-indigo-50/50 rounded-r-2xl transition-all">
                                    <span class="px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-[10px] font-extrabold uppercase tracking-widest">Confirmed</span>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

</body>
</html>
