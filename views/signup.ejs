<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <link rel="stylesheet" href="/css/pageCss/signup.css">
  </head>

  <body>

    <div class="signup-container">
      <% if (typeof errorMessage !=="undefined" && errorMessage) { %>
        <script>
          alert("<%= errorMessage %>")
        </script>
        <% } %>

      <h2>Create Account</h2>

      <form action="/signup" method="POST">

        <div class="input-group">
          <label>Full Name</label>
          <input type="text" name="name" placeholder="Enter your name" required>
        </div>

        <div class="input-group">
          <label>Email</label>
          <input type="email" name="email" placeholder="Enter your email" required>
        </div>

        <div class="input-group">
          <label>Password</label>
          <input type="password" name="password" placeholder="Enter password" required>
        </div>

        <div class="input-group">
          <label>Confirm Password</label>
          <input type="password" name="confirmPassword" placeholder="Confirm password" required>
        </div>

        <div class="input-group">
          <label>Role</label>

          <select name="role" id="roleSelect" required>
            <option value="">Select Role</option>
            <option value="admin">Admin</option>
            <option value="instructor">Instructor</option>
          </select>

        </div>


        <div class="input-group" id="specializationGroup">
          <label>Specialization</label>
          <select name="specialization" id="specializationSelect" required>
            <option value="">Select The Subject</option>
            <option value="Web Development">Web Development</option>
            <option value="Data Science">Data Science</option>
            <option value="Cyber Security">Cyber Security</option>
            <option value="DBMS">DBMS</option>
            <option value="Green Computing">Green Computing</option>
          </select>
        </div>

        <div class="input-group">
          <label>Contact details</label>
          <input type="tel" name="contact" placeholder="Enter 10 digit phone number" required>
        </div>



        <button type="submit">Sign Up</button>

        <p class="login-link">
          Already have an account?
          <a href="/login"> <b><i>Login</i></b></a>
        </p>

      </form>

    </div>
    <script src="/js/pageJS/signUp.js"></script>
  </body>

</html>
