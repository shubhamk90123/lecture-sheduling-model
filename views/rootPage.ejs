<!DOCTYPE html>
<html lang="en">

    <head>
        <%- include('partials/head') %>
    </head>

    <body class="auth-page">

        <div class="hero-section">
            <div class="hero-icon-large flex-center">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>
            <h1>Lecture Scheduling Model.</h1>
            <p>
                Streamline your academic management with conflict-aware scheduling,
                instructor tracking, and real-time curriculum updates.
            </p>

            <div class="btn-group">
                <a href="/login" class="btn-primary px-3 py-1 text-lg">Get Started</a>
                <a href="/signup" class="btn-outline px-3 py-1 text-lg">Create Account</a>
            </div>

            <div class="hero-stats-container">
                <div class="hero-stat-item">
                    <div class="hero-stat-value">100%</div>
                    <div class="hero-stat-label">Accuracy</div>
                </div>
                <div class="hero-stat-divider"></div>
                <div class="hero-stat-item">
                    <div class="hero-stat-value">Zero</div>
                    <div class="hero-stat-label">Conflicts</div>
                </div>
                <div class="hero-stat-divider"></div>
                <div class="hero-stat-item">
                    <div class="hero-stat-value">Real-time</div>
                    <div class="hero-stat-label">Sync</div>
                </div>
            </div>
        </div>

    </body>

</html>