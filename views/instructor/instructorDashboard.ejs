<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instructor Dashboard</title>
    <link rel="stylesheet" href="/css/instructorCss/instDashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

  </head>

  <body>

    <div class="sidebar">

      <h2><i class="fa fa-calendar"></i> Lecture Scheduler</h2>

      <ul>
        <li><i class="fa fa-home"></i> <a href="/instructor/instructorDashboard">Dashboard</a> </li>
        <li><i class="fa fa-book"></i> <a href="/instructor/lectures">My Lectures</a></li>
        <li><i class="fa fa-user"></i> <a href="/instructor/profile">My Profile</a></li>
        <li><i class="fa fa-sign-out"></i> <a href="/logout">Logout</a></li>
      </ul>

    </div>


    <div class="main">

      <div class="topbar">



        <h1>Instructor Dashboard</h1>

        <div class="profile">
          Welcome, <%= currentUserName %>
          <i class="fa fa-user-circle"></i>
        </div>

      </div>


      <div class="cards">

        <div class="card">
          <i class="fa fa-book"></i>
          <h3>Assigned Lectures</h3>
          <p>
            <%= totalCourses %>
          </p>
        </div>

        <div class="card">
          <i class="fa fa-calendar"></i>
          <h3>Upcoming Lectures</h3>
          <p>
            <%= totalCourses %>
          </p>
        </div>

        <div class="card">
          <i class="fa fa-clock"></i>
          <h3>Past Lectures</h3>
          <p>5</p>
        </div>

      </div>



      <div class="table-box">

        <div class="table-header">

          <h2>My Upcoming Lectures</h2>

          <a href="/instructor/lectures">View All Lectures</a>

        </div>

        <table>

          <thead>

            <tr>
              <th>Course</th>
              <th>Date</th>
              <th>Duration</th>
              <th>Level</th>
              <th>Time</th>
            </tr>

          </thead>


          <tr>
            <% if (!lectureData || lectureData.length===0) { %>
          <tr>
            <td colspan="4">No lectures scheduled</td>
          </tr>
          <% } %>

            <% lectureData.forEach((lec)=> { %>
              <tr>
                <td>
                  <%= lec.courseName %>
                </td>
                <td>
                  <%= lec.startDate %>
                </td>
                <td>
                  <%= lec.duration %>
                </td>
                <td>
                  <%= lec.courseCode %>
                </td>
                <td>
                  10 AM
                </td>
              </tr>
              <% }) %>
                </tr>

                </tbody>

        </table>

      </div>

    </div>

  </body>

</html>
