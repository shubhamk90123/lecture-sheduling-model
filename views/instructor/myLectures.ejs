<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Lectures</title>
    <link rel="stylesheet" href="/css/instructorCss/myLectures.css">
  </head>

  <body>

    <div class="container">

      <h2>My Lectures</h2>

      <table>

        <thead>
          <tr>
            <th>ID</th>
            <th>Course Name</th>
            <th>Date</th>
            <th>Level</th>
            <th>Duration</th>
            <th>Time</th>
          </tr>
        </thead>

        <tbody>

          <tr>
            <% if (lectureData.length===0) { %>
          <tr>
            <td colspan="3">No instructors found</td>
          </tr>
          <% } %>
            <% lectureData.forEach((ins, idx)=> { %>
              <tr>
                <td>
                  <%= idx +1 %>
                </td>
                <td>
                  <%= ins.courseName %>
                </td>
                <td>
                  <%= ins.startDate %>
                </td>
                <td>
                  <%= ins.courseCode %>
                </td>
                <td>
                  <%= ins.duration %>
                </td>
                <td>
                  10 Am
                </td>
              </tr>
              <% }) %>
                </tr>

        </tbody>

      </table>
      <div class="dashboard">
        <a href="/instructor/instructorDashboard">GO TO DASHBOARD</a>
      </div>

    </div>

  </body>

</html>