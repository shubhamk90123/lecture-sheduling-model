<!DOCTYPE html>
<html lang="en">

  <head>
    <%- include('../partials/head') %>
  </head>

  <body>

    <%- include('../partials/sidebar') %>

    <div class="main">

      <%- include('../partials/topbar') %>

      <div class="container">

        <h2>My Lectures</h2>

        <table>
          <thead>
            <tr>
              <th>No</th>
              <th>Course Name</th>
              <th>Date</th>
              <th>Level</th>
              <th>Duration</th>
              <th>Time</th>
            </tr>
          </thead>
          <tbody>
            <% if (!lectureData || lectureData.length === 0) { %>
              <tr><td colspan="6">No lectures assigned yet</td></tr>
            <% } %>
            <% (lectureData || []).forEach((lec, idx) => { %>
              <tr>
                <td><%= idx + 1 %></td>
                <td><%= lec.courseName %></td>
                <td><%= lec.startDate || lec.date %></td>
                <td><%= lec.courseCode || lec.level %></td>
                <td><%= lec.duration %></td>
                <td><%= lec.startTime || '—' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>

      </div>

    </div>

  </body>

</html>
