<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instructor Dashboard</title>
    <link rel="stylesheet" href="/instructorCss/css/instDashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

  </head>

  <body>

    <div class="sidebar">

      <h2><i class="fa fa-calendar"></i> Lecture Scheduler</h2>

      <ul>
        <li class="active"><i class="fa fa-home"></i> <a href="/instructor/dashboard">Dashboard</a> </li>
        <li><i class="fa fa-book"></i> <a href="/instructor/lectures">My Lectures</a></li>
        <li><i class="fa fa-user"></i> <a href="/instructor/profile">My Profile</a></li>
        <li><i class="fa fa-sign-out"></i> <a href="/login">Logout</a></li>
      </ul>

    </div>


    <div class="main">

      <div class="topbar">

        <h1>Instructor Dashboard</h1>

        <div class="profile">
          Welcome, John Doe
          <i class="fa fa-user-circle"></i>
        </div>

      </div>


      <div class="cards">

        <div class="card">
          <i class="fa fa-book"></i>
          <h3>Assigned Lectures</h3>
          <p>8</p>
        </div>

        <div class="card">
          <i class="fa fa-calendar"></i>
          <h3>Upcoming Lectures</h3>
          <p>3</p>
        </div>

        <div class="card">
          <i class="fa fa-clock"></i>
          <h3>Past Lectures</h3>
          <p>5</p>
        </div>

      </div>



      <div class="table-box">

        <div class="table-header">

          <h2>My Upcoming Lectures</h2>

          <button id="viewLectures">View All Lectures</button>

        </div>

        <table>

          <thead>

            <tr>
              <th>Course</th>
              <th>Date</th>
              <th>Time</th>
              <th>Actions</th>
            </tr>

          </thead>


          <tbody id="lectureTable">

            <tr>
              <td>Web Development</td>
              <td>May 25, 2024</td>
              <td>10:00 AM</td>
              <td><button class="details">View Details</button></td>
            </tr>

            <tr>
              <td>Data Science</td>
              <td>May 27, 2024</td>
              <td>02:00 PM</td>
              <td><button class="details">View Details</button></td>
            </tr>

            <tr>
              <td>Cyber Security</td>
              <td>May 30, 2024</td>
              <td>09:00 AM</td>
              <td><button class="details">View Details</button></td>
            </tr>

          </tbody>

        </table>

      </div>

    </div>

    <script src="/js/instructor.js"></script>

  </body>

</html>